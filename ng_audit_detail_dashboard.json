    {
      "id": 50,
      "type": "table",
      "title": "Data Retention Status",
      "description": "All tables checked in this audit run. Failing tables are also summarised (consolidated) in the Threshold Breaches panel above.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 60 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "table_name" },
            "properties": [{ "id": "displayName", "value": "Table" }]
          },
          {
            "matcher": { "id": "byName", "options": "days_diff" },
            "properties": [{ "id": "displayName", "value": "Days Behind" }]
          },
